.pv.b{background:linear-gradient(135deg,#0b1026,#3b1478 55%,#ff4fd855)}
.pv.c{background:linear-gradient(135deg,#5a0f4a88,#1a0b3b 50%,#0d1f5a)}
.pv svg{width:100%;height:100%;transition:transform .6s var(--ease)}
