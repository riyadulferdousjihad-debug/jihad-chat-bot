.ir:nth-child(2n) .ii::after{animation-delay:-1.3s}
@keyframes pu{from{transform:scale(1);opacity:.8}to{transform:scale(1.5);opacity:0}}
.ir:hover .ii{transform:rotate(-8deg) scale(1.1)}
.ir small{display:block;color:var(--mu);font-size:.8rem}
