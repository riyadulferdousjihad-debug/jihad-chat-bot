.btn{display:inline-flex;align-items:center;gap:10px;padding:14px 26px;border-radius:999px;font-weight:600;border:1px solid var(--bd);cursor:pointer;transition:transform .3s var(--ease),box-shadow .3s,background .3s;font:inherit;font-weight:600;color:var(--tx);background:var(--gl)}
