.card3d{position:relative;width:min(320px,72vw);aspect-ratio:4/4.6;transform-style:preserve-3d;transition:transform .15s ease-out;will-change:transform}
.card3d .frame{position:absolute;inset:0;border-radius:28px;overflow:hidden;border:1px solid #c9a8ff66;box-shadow:0 30px 70px -20px #000,0 0 50px -8px var(--v);background:var(--pur)}
.card3d img{width:100%;height:100%;object-fit:cover;object-position:50% 20%}
.card3d .frame::after{content:"";position:absolute;inset:0;background:linear-gradient(160deg,#ffffff22,transparent 35%,#8b5cf633 100%)}
.chip{position:absolute;padding:8px 14px;border-radius:14px;font-size:.82rem;white-space:nowrap;transform:translateZ(70px);animation:fl 5s ease-in-out infinite}
.c1{top:8%;left:-14%}.c2{bottom:14%;right:-12%;animation-delay:-2s}.c3{bottom:-4%;left:6%;animation-delay:-3.5s}
@keyframes fl{50%{translate:0 -12px}}
.cube{position:absolute;width:26px;height:26px;border:1.5px solid var(--pk);border-radius:6px;transform:translateZ(110px) rotate(20deg);top:-4%;right:6%;box-shadow:0 0 16px var(--pk);animation:fl 6s ease-in-out infinite}
