.dr{stroke-dasharray:420;stroke-dashoffset:420;animation:dr 3.5s ease-in-out infinite alternate}
@keyframes dr{to{stroke-dashoffset:0}}
.bar{transform-box:fill-box;transform-origin:bottom;animation:bar 2.8s ease-in-out infinite alternate}
